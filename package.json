{
  "name": "rishi-dusane-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "db:setup": "npm run db:setup --workspace server",
    "test": "npm run test --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "lint": "eslint client/src server/src server/scripts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
